# Maintainer: lumina PDF Inc <contact@luminapdf.com>
pkgname=lumina-pdf-desktop
pkgver=2.10.1
pkgrel=1
pkgdesc="Locally hosted, web-based PDF manipulation tool (Tauri desktop app, official lumina PDF Inc build)"
arch=('x86_64')
url="https://www.lumina.com"
license=('MIT' 'LicenseRef-lumina-PDF-Proprietary')
depends=('gtk3' 'webkit2gtk-4.1' 'libappindicator-gtk3')
provides=('lumina-pdf')
conflicts=('lumina-pdf' 'lumina-pdf-git' 'lumina-pdf-bin')
options=('!strip')

source_x86_64=("${pkgname}-${pkgver}.deb::https://github.com/lumina-Tools/lumina-PDF/releases/download/v${pkgver}/lumina-PDF-linux-x86_64.deb")
sha256sums_x86_64=('PLACEHOLDER_DEB_SHA256')

package() {
    # Extract the .deb archive
    bsdtar -xf data.tar* -C "${pkgdir}"

    # Fix permissions
    find "${pkgdir}" -type d -exec chmod 755 {} \;

    # Install license
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" <<EOF
Copyright (c) 2025 lumina PDF Inc
All rights reserved. See https://github.com/lumina-Tools/lumina-PDF/blob/main/LICENSE
EOF
}
