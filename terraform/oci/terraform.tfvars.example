# OCI Provider Credentials
tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaaxxxxxxxxxxxxxxxxx"
user_ocid        = "ocid1.user.oc1..aaaaaaaaxxxxxxxxxxxxxxxxx"
fingerprint      = "xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"

# Compartment Settings
compartment_ocid = "ocid1.compartment.oc1..aaaaaaaaxxxxxxxxxxxxxxxxx"

# Compute Shape Selection
instance_name          = "lumina-pdf-server"
instance_shape         = "VM.Standard.E4.Flex" # Change to "VM.Standard.A1.Flex" for Ampere ARM free tier
instance_ocpus         = 1
instance_memory_in_gbs = 8

# SSH Credentials
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC..."

# Application Config
lumina_image          = "frooodle/s-pdf:latest"
app_name              = "My Lumina-PDF Service"
security_enable_login = "false"
system_default_locale = "en-GB"
