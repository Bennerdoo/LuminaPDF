# Maintainer: lumina PDF Inc <contact@luminapdf.com>
pkgname=lumina-pdf-server-bin
pkgver=2.10.1
pkgrel=1
pkgdesc="Locally hosted, web-based PDF manipulation tool (server JAR, prebuilt)"
arch=('any')
url="https://www.lumina.com"
license=('MIT' 'LicenseRef-lumina-PDF-Proprietary')
depends=('java-runtime>=25')
provides=('lumina-pdf-server')
conflicts=('lumina-pdf-server' 'lumina-pdf-server-git')
backup=('etc/lumina-pdf-server/settings.yml')

source=("lumina-PDF-with-login-${pkgver}.jar::https://github.com/lumina-Tools/lumina-PDF/releases/download/v${pkgver}/lumina-PDF-with-login.jar")
sha256sums=('PLACEHOLDER_JAR_SHA256')

package() {
    # JAR
    install -Dm644 "lumina-PDF-with-login-${pkgver}.jar" \
        "${pkgdir}/usr/share/lumina-pdf-server/lumina-pdf-server.jar"

    # Wrapper script
    install -Dm755 /dev/stdin "${pkgdir}/usr/bin/lumina-pdf-server" << 'EOF'
#!/bin/sh
exec java $JAVA_OPTS -jar /usr/share/lumina-pdf-server/lumina-pdf-server.jar "$@"
EOF

    # systemd unit
    install -Dm644 /dev/stdin "${pkgdir}/usr/lib/systemd/system/lumina-pdf-server.service" << 'EOF'
[Unit]
Description=lumina-PDF Server
After=network.target

[Service]
Type=simple
User=lumina-pdf
Group=lumina-pdf
WorkingDirectory=/var/lib/lumina-pdf-server
ExecStart=/usr/bin/java -jar /usr/share/lumina-pdf-server/lumina-pdf-server.jar
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumina-pdf-server
Environment=JAVA_OPTS=-Xmx512m

[Install]
WantedBy=multi-user.target
EOF

    # sysusers
    install -Dm644 /dev/stdin "${pkgdir}/usr/lib/sysusers.d/lumina-pdf-server.conf" << 'EOF'
u lumina-pdf - "lumina-PDF Server" /var/lib/lumina-pdf-server -
EOF

    # tmpfiles
    install -Dm644 /dev/stdin "${pkgdir}/usr/lib/tmpfiles.d/lumina-pdf-server.conf" << 'EOF'
d /var/lib/lumina-pdf-server 0750 lumina-pdf lumina-pdf -
d /var/log/lumina-pdf-server 0750 lumina-pdf lumina-pdf -
EOF

    # Default config stub
    install -dm755 "${pkgdir}/etc/lumina-pdf-server"
    install -Dm644 /dev/stdin "${pkgdir}/etc/lumina-pdf-server/settings.yml" << 'EOF'
# lumina-PDF Server configuration
# See https://github.com/lumina-Tools/lumina-PDF for all options
server:
  port: 8080
EOF

    # License
    install -Dm644 /dev/stdin "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE" << 'EOF'
MIT License with proprietary carve-outs (open-core).
SPDX: MIT AND LicenseRef-lumina-PDF-Proprietary
See https://github.com/lumina-Tools/lumina-PDF/blob/main/LICENSE
EOF
}
